<?xml version="1.0"?>
<ruleset name="Coquille Revue">
	<description>Coquille Revue: WordPress Coding Standards 3 (security, database, WordPress API) and PHPCompatibilityWP.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/claude-plugin/*</exclude-pattern>
	<!-- Scripts run with wp eval-file on a test site, not loaded by the plugin. -->
	<exclude-pattern>/tests/injection/*</exclude-pattern>
	<!-- Generated by wp i18n make-php. -->
	<exclude-pattern>/languages/*.l10n.php</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="./"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<!-- PHP 7.4 and later. -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Same value as "Requires at least" in coquille-revue.php. -->
	<config name="minimum_wp_version" value="6.2"/>

	<!-- Step 1: security, database and WordPress API. Step 2, after a reformatting commit with
	     vendor/bin/phpcbf: replace these three rules with <rule ref="WordPress"/>, and exclude
	     /tests/* from WordPress.Files.FileName. -->
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB"/>
	<rule ref="WordPress.WP"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="coquille_revue"/>
			</property>
		</properties>
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="coquille-revue"/>
			</property>
		</properties>
	</rule>
	<!-- PHPUnit tests query the plugin table directly to check what it stores. -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
