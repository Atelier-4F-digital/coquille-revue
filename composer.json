{
  "name": "atelier-4f-digital/coquille-revue",
  "description": "Coquille Revue development tools (coding standards, tests). Not shipped with the plugin.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "1.2.1",
    "phpcompatibility/phpcompatibility-wp": "2.1.8",
    "phpunit/phpunit": "9.6.38",
    "squizlabs/php_codesniffer": "3.13.6",
    "wp-coding-standards/wpcs": "3.4.1",
    "yoast/phpunit-polyfills": "4.0.0"
  },
  "config": {
    "platform": {
      "php": "7.4.33"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "phpcs": "phpcs",
    "test": "phpunit",
    "test:multisite": [
      "@putenv WP_MULTISITE=1",
      "phpunit"
    ]
  }
}
